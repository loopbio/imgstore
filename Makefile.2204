VERSION=$(shell grep -oP "^__version__ = '\K([^'~]+)(?=')" imgstore/__init__.py | sed -r 's/-/~/g')
PKG_VERSION=0jrs1
DEB_DIR?=.

FPM?=fpm
PYTHON?=python3
# fpm >= 1.16 stages python packages with pip install --root, which silently skips the
# wheel when the same version is already installed on the build host
export PIP_IGNORE_INSTALLED=1

deb: ${DEB_DIR}/python3-imgstore_${VERSION}-${PKG_VERSION}_all.deb

${DEB_DIR}/python3-imgstore_${VERSION}-${PKG_VERSION}_all.deb: setup.py $(MAKEFILE_LIST) | ${DEB_DIR}
	$(FPM) --verbose --force \
		-p $@ \
		--maintainer "John Stowers <john.stowers@gmail.com>" \
		-s python -t deb \
		-n python3-imgstore \
		--no-python-dependencies \
		--python-internal-pip \
		--python-bin=${PYTHON} \
		--python-package-name-prefix=python3 \
		--version ${VERSION}-${PKG_VERSION} \
		-d "python3-h5py" \
		-d "python3-numpy" \
		-d "python3-pandas" \
		-d "python3-yaml" \
		-d "python3-dateutil" \
		-d "python3-tzlocal" \
		-d "python3-opencv" \
		$<

clean:
	rm -rf build imgstore.egg-info
	rm -f ${DEB_DIR}/python3-imgstore_${VERSION}-${PKG_VERSION}_all.deb

${DEB_DIR}:
	mkdir -p $@

.PHONY: clean
